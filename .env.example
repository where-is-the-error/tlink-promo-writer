# 복사해서 .env.local 로 쓰세요. .env.local 은 git에 올라가지 않습니다.

# ── 프론트엔드 ─────────────────────────────
# mock: 화면만 확인 (가짜 데이터, API 없이 동작)
# api : 실제 API 라우트(/api/...) 호출
NEXT_PUBLIC_DATA_SOURCE=mock

# ── 서버 전용 (브라우저로 노출 금지) ──
GEMINI_API_KEY=
# 모델(비우면 기본값). pro: 카드 생성·원문 대조 / flash: 사진 분류·글 쓰기 / lite: 지시문 판별
GEMINI_MODEL_PRO=gemini-3.8-flash
GEMINI_MODEL_FLASH=gemini-3.8-flash
GEMINI_MODEL_LITE=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# 100만 토큰당 달러 단가. 넣지 않으면 비용이 0으로 기록되고 글 1건 비용 상한이 걸리지 않는다.
GEMINI_PRICE_INPUT_PER_MTOK=
GEMINI_PRICE_OUTPUT_PER_MTOK=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. 브라우저로 내려보내지 않는다.
SUPABASE_SERVICE_ROLE_KEY=
# 로그인 허용 계정(비우면 로그인한 모든 계정 허용)
ALLOWED_USER_EMAIL=
COST_CAP_PER_POST_USD=1.00
