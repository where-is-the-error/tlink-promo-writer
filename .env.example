# 복사해서 .env.local 로 쓰세요. .env.local 은 git에 올라가지 않습니다.

# ── 프론트엔드 ─────────────────────────────
# mock: 화면만 확인 (가짜 데이터, API 없이 동작)
# api : 실제 API 라우트(/api/...) 호출
NEXT_PUBLIC_DATA_SOURCE=mock

# ── 서버 전용 (브라우저로 노출 금지) ──
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. 브라우저로 내려보내지 않는다.
SUPABASE_SERVICE_ROLE_KEY=
# 로그인 허용 계정(비우면 로그인한 모든 계정 허용)
ALLOWED_USER_EMAIL=
COST_CAP_PER_POST_USD=1.00
